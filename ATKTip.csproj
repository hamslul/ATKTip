<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <Version>1.2.2</Version>
    <Author>hamslul</Author>
    <Name>ATKTip</Name>
    <Punchline>FFLogs-powered rotation timelines for every fight and job.</Punchline>
    <Description>Aggregated top 100 FFLogs with custom timelines.</Description>
    <PackageProjectUrl>https://github.com/hamslul/ATKTip</PackageProjectUrl>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <IsPackable>false</IsPackable>
    <DalamudApiLevel>15</DalamudApiLevel>
    <Tags>combat,timeline,fflogs,rotation,overlay,raid</Tags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <None Include="json.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="ATKTip.BMR.encounters.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <EmbeddedResource Include="ATKTip.BMR.encounters.json" />
  </ItemGroup>

  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <OutputPath>bin\x64\Release</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <Target Name="CopyRepositoryManifest" AfterTargets="Build">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;Copy-Item -LiteralPath '$(MSBuildProjectDirectory)\json.txt' -Destination '$(TargetDir)ATKTip.json' -Force&quot;" />
  </Target>

</Project>
